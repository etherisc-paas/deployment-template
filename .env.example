# Copy to `.env` before `docker compose up` (see README).

# Postgres
POSTGRES_USER=framework
POSTGRES_PASSWORD=framework
POSTGRES_DB=framework

# App connectivity (docker network hostname `postgres`)
DATABASE_URL=postgresql://framework:framework@postgres:5432/framework

# HTTP
APP_PUBLISH_PORT=3000
APP_PORT=3000

# pnpm / GitHub Packages (local install outside Docker)
NODE_AUTH_TOKEN=

# Integration placeholders (surface in deployment-config.json)
DEPLOYMENT_PAYMENTS_API_KEY=
DEPLOYMENT_TENANT_PROVISIONING_URL=
