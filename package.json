{
  "name": "@etherisc-paas/deployment-template",
  "version": "0.0.0",
  "private": true,
  "description": "Forkable docker-compose deployment template (thin wrapper over framework + products + platform-app).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node -e \"console.log('build: replace with pnpm install + framework build after packages publish')\"",
    "test": "node -e \"console.log('tests: phase after loadProduct')\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate-deployment-config": "node scripts/validate-deployment-config.mjs"
  },
  "dependencies": {
    "@etherisc/framework": "0.0.1-alpha.0",
    "@etherisc/product-parametric-insurance": "0.0.1-alpha.0",
    "@etherisc/product-utils-payments": "0.0.1-alpha.0"
  },
  "devDependencies": {
    "eslint": "9.16.0",
    "typescript": "5.7.2"
  }
}
