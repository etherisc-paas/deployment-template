{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etherisc-paas.github.io/schemas/module.manifest.schema.json",
  "title": "Module manifest (RES-22 Stage 1 spine)",
  "description": "Declares what a repo is and what it consumes/publishes. Stage 1 spine; schema bodies come in Stage 2.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "entities",
    "commands",
    "queries",
    "events",
    "consumes",
    "publishes",
    "tenancy",
    "retention",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Manifest schema version (semver major.minor).",
      "type": "string",
      "const": "1.0"
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "repo", "owners"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": ["library", "service", "app", "module", "tooling", "other"]
        },
        "repo": {
          "description": "GitHub repo path etherisc-paas/<name> or full https URL.",
          "type": "string",
          "minLength": 1
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "default": []
    },
    "consumes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modules", "topics", "contracts"],
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "visibility"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "type": "string",
                "enum": ["internal", "public"]
              }
            }
          },
          "default": []
        }
      }
    },
    "publishes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topics", "contracts"],
      "properties": {
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "visibility"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "visibility": {
                "type": "string",
                "enum": ["internal", "public"]
              }
            }
          },
          "default": []
        }
      }
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["none", "org", "workspace", "user"]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": {
          "type": "string",
          "enum": ["ephemeral", "standard", "regulated", "permanent"]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research", "plans", "adrs", "pdrs"],
      "properties": {
        "research": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^research\\.[a-z0-9][a-z0-9.-]*$"
          },
          "default": []
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^track\\.[a-z0-9][a-z0-9.-]*$"
          },
          "default": []
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^ADR-[0-9]{4}$"
          },
          "default": []
        },
        "pdrs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PDR-[0-9]{4}$"
          },
          "default": []
        }
      }
    }
  }
}
